# TPT-RFID System Environment Variables
# Copy this file to .env and configure with your values

# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-secrets.token_hex(32)

# Database Configuration
# Default (when unset): SQLite at <repo>/instance/tpt_rfid.db
# DATABASE_URL=sqlite:////absolute/path/to/tpt_rfid.db
# PostgreSQL alternative (pip install psycopg2-binary first):
# DATABASE_URL=postgresql://username:password@host:port/database_name

# Admin PIN hash (not the PIN itself). Set it with:
#   .venv/bin/python scripts/set_admin_pin.py
# Without it, the default PIN 133133 is used.
# ADMIN_PIN_HASH=

# USB UHF reader (HW-VX6336)
# false = mock reader (scans only via /debug/scan in development)
RFID_READER_ENABLED=false
# /dev/rfid-reader comes from deploy/jetson/99-tpt-rfid-reader.rules
RFID_READER_PORT=/dev/ttyUSB0
# Seconds a tag must be away before the same tag counts as a new tap
RFID_ABSENT_TIMEOUT=2.5
# Seconds a tool tag may be unseen before it counts as gone from the reader field
RFID_MISSING_AFTER=1.5
# Extra seconds an unborrowed tool must stay gone before the alarm and beep
RFID_ALARM_CONFIRM_SECONDS=0.5
# Beep the reader when a tool that is not borrowed leaves the field
RFID_ALARM_ENABLED=true

# PN532 NFC reader for student cards (KTM) over I2C (false = mock reader)
NFC_READER_ENABLED=false

# USB camera: registration photo, admin face login, tool photos, alarm photos
# (false = mock camera, no frames). Face models: scripts/fetch_face_models.py
CAMERA_ENABLED=false
CAMERA_INDEX=0

# Kiosk session length (s), extension per tool event, cap from now, and how
# old (s) an open alarm may be to become a borrow by the next identified student
KIOSK_SESSION_SECONDS=60
KIOSK_SESSION_EXTEND=30
KIOSK_SESSION_MAX_SECONDS=120
ALARM_GRACE_SECONDS=30
# Seconds the alarm overlay stays on the kiosk (the alarm stays open for admin)
ALARM_OVERLAY_SECONDS=30

# Email Configuration (optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Automatic loan reminder emails (due, and LOAN_OVERDUE_REMINDER_DAYS later).
# Needs MAIL_USERNAME + MAIL_PASSWORD (Gmail app password). Preview first:
#   .venv/bin/python scripts/loan_reminders.py
LOAN_REMINDERS_ENABLED=false
LOAN_OVERDUE_REMINDER_DAYS=2
LOAN_REMINDER_INTERVAL_SECONDS=300

# Admin face login (kiosk screen only; PIN stays the fallback). Needs
# CAMERA_ENABLED=true and the models in models/face/.
FACE_LOGIN_ENABLED=false
# Liveness models (minifas, minifas_se, mn3) with real-face thresholds; a
# frame must pass all. Calibrate with scripts/face_spoof_bench.py.
FACE_LIVENESS_MODELS=mn3:0.5
# Recognizer: arcface_mbf (default) or sface; switching needs re-enrolment.
FACE_RECOGNIZER=arcface_mbf
# Cosine distance; empty = recognizer default (arcface_mbf 0.65, sface 0.637),
# lower is stricter. The login log shows each attempt's distance.
FACE_MATCH_THRESHOLD=
